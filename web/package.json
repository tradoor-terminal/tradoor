{
  "name": "tradoor-web",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "deno test --quiet --allow-read=src/wasm",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "app js",
      "path": ["dist/assets/index-*.js", "dist/assets/solid-*.js", "dist/assets/store-*.js", "dist/assets/api-*.js", "dist/assets/markets-*.js", "dist/assets/prefs-*.js"],
      "limit": "69 kB"
    },
    {
      "name": "engine worker js",
      "path": "dist/assets/worker-*.js",
      "limit": "27 kB"
    },
    {
      "name": "engine wasm",
      "path": "dist/assets/tradoor_wasm_bg-*.wasm",
      "limit": "158 kB",
      "gzip": true
    },
    {
      "name": "frost script wasm",
      "path": "dist/assets/frost-script-*.wasm",
      "limit": "91 kB",
      "gzip": true
    },
    {
      "name": "order signer wasm",
      "path": "dist/assets/trade-*.wasm",
      "limit": "32 kB",
      "gzip": true
    },
    {
      "name": "lighter signer wasm",
      "path": "dist/assets/lighter-*.wasm",
      "limit": "2800 kB",
      "gzip": true
    }
  ],
  "dependencies": {
    "solid-js": "1.9.17"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@size-limit/file": "13.1.1",
    "size-limit": "13.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-solid": "2.11.17"
  }
}
